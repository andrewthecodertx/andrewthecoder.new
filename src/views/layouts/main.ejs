<%
  const url = "https://andrewthecoder.com";
  const siteTitle = "ANDREW THE CODER";
%>

<!DOCTYPE html>
<html lang="en">
  <%- include('partials/basehead', { url, siteTitle, pageTitle: typeof pageTitle
  !== 'undefined' ? pageTitle : '', description: typeof description !==
  'undefined' ? description : '', pageImage: typeof pageImage !== 'undefined' ?
  pageImage : '', pageUrl: typeof pageUrl !== 'undefined' ? pageUrl : '', }) %>

  <body>
    <div id="page_wrapper">
      <header id="page_header"><%- include('partials/header') %></header>
      <main>
        <%- body %>
      </main>
    </div>
    <footer>
      <%- include('partials/footer') %>
    </footer>
  </body>
</html>
