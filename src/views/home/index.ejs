<%- extend('layouts/main') %>
<h2>Welcome Aboard</h2>
<section id=""></section>

<article class=""></article>

<article class=""></article>

<aside class="aside">
  <header class="aside__header">
    <h3>some things to see and do</h3>
  </header>
  <div id="latest_posts">
    <h3>Recent Posts</h3>
    <ul class="list">
      <% recentposts.forEach((post) => { %>
      <li class="list__item">
        <a class="list__link" href="/blog/<%= post.slug %>"
          ><%= post.meta.title %></a
        >
        <span class="post__date"><%= formatDate(post.meta.publishDate) %></span>
      </li>
      <% }) %>
      <li>all blogs <a href="/blog">-></a></li>
    </ul>
  </div>
  <div id="current_projects">
    <h3>Current Projects</h3>
    <ul class="list">
      <% projects.forEach((project) => { %>
      <li class="list__item">
        <a class="list__link" href="<%= project.url %>"><%= project.name %></a>
      </li>
      <% }) %>
      <li>all projects <a href="/projects">-></a></li>
    </ul>
  </div>
  <div id="recent_demos">
    <h3>Some Demos</h3>
    <ul class="list">
      <% demos.forEach((demo) => { %>
      <li class="list__item">
        <a class="list__link" href="<%= demo.url %>"><%= demo.name %></a>
      </li>
      <% }) %>
      <li>all demos <a href="/demos">-></a></li>
    </ul>
  </div>
</aside>
