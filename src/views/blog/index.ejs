<%- extend('layouts/main') %>
<h1>Blog</h1>
<p>A running log on code, philosophy, and tools.</p>
<ul class="post-list">
  <% posts.forEach((post) => { %>
  <li class="post-item">
    <a href="/blog/<%= post.slug %>"><%= post.meta.title %></a>
    <span class="post-date"><%= post.meta.publishDate %></span>
  </li>
  <% }) %>
</ul>
